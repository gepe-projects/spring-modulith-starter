<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration (see §7 of agents.md).

  Default profile: human-readable console pattern including the MDC requestId
                   (printed as '-' outside a request scope).
  json profile: structured JSON console output (Logstash encoder), ready to be
                shipped to Loki/ELK. Activate with spring.profiles.active=json
                or the SPRING_PROFILES_ACTIVE environment variable.
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name"
                    defaultValue="spring-modulith-starter"/>

    <!-- Human-readable console logging (default). -->
    <springProfile name="!json">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{requestId:--}] %logger{40} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Structured JSON console logging (collector / container deployments). -->
    <springProfile name="json">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdc>true</includeMdc>
                <customFields>{"app":"${appName}"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

</configuration>
